# Used by run.sh; for direct uvicorn use --env-file .env.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT_S=8
OLLAMA_NUM_PREDICT=1024
OLLAMA_KEEP_ALIVE=30m
# auto: schema decoding for local models, prompt JSON for cloud models.
OLLAMA_FORMAT=auto
# For https://ollama.com direct API access only (never commit a real key).
OLLAMA_API_KEY=
